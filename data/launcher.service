[Unit]
Description=Launcher (apps, files, clipboard, snippets)
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.jinwei.Launcher
ExecStart=%h/.local/bin/launcher --daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
